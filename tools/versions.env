# Single source of truth for every tool version in the project.
# docker/Dockerfile reads this file (via tools/install_pinned.sh); CI tags the image
# with a hash of it. Change a pin here and nowhere else.

# Base image for the container (tag + digest).
BASE_IMAGE=ubuntu:24.04@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8

# OSS CAD Suite: Verilator, Yosys (+ slang plugin), SymbiYosys, Surfer/GTKWave.
OSS_CAD_SUITE_DATE=2026-11-17
OSS_CAD_SUITE_SHA256=d31c77e62aff4c922285ffc5265afa92034199206abb188bc72c0ee97b85e749

# RISC-V GCC: xPack riscv-none-elf (newlib, multilib incl. rv32im/ilp32).
RISCV_GCC_VERSION=15.2.0-1
RISCV_GCC_SHA256=aaaa8060c914851a3e5ee1ba82cc3d6f80972f90638a05c6e823a37557a33758

# Python packages (installed into a venv).
PY_PYTEST=9.2.0
PY_PYELFTOOLS=0.33
PY_NUMPY=2.5.5
PY_MATPLOTLIB=3.11.2
PY_PYYAML=6.0.3

# sky130 PDK (sky130_fd_sc_hd standard cells and the OpenRAM sky130_sram_macros),
# installed by ciel from the open_pdks build of this commit. Area reports (M4),
# place and route (M5).
PY_CIEL=3.2.0
SKY130_OPEN_PDKS=e7a6777d157a9d94c7ac757457b9e4309e9e9000

# Place and route (M5): OpenROAD-flow-scripts (its flow/ directory, sky130 platforms
# only) and OpenROAD at the commit ORFS pins as its tools/OpenROAD submodule
# (install checks they agree). OpenROAD builds with Bazel (hermetic LLVM
# toolchain) in a separate image stage, through bazelisk. ORFS is pinned to the
# commit of an official daily image (git describe 26Q4-507-g2ba1223c8), not the
# 26Q4 tag: that tag's OpenROAD no longer builds (GitHub's archive of a Bazel
# dependency changed, so its registry checksum fails).
ORFS_COMMIT=2ba1223c8e39f7a16950ed0272ca8faa391cba84
OPENROAD_COMMIT=e7c6b85b2cf65e6789350defc712cc783c004e13
BAZELISK_VERSION=1.28.1
BAZELISK_SHA256=22e7d3a188699982f661cf4687137ee52d1f24fec1ec893d91a6c4d791a75de8

# Submodules (third_party/spike, third_party/riscv-tests, rtl/core/cv32e40x)
# are pinned by their commits in the superproject, not here.
